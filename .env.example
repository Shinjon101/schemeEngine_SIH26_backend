# Postgres (Neon) connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional - defaults to 3000. Render injects PORT automatically.
PORT=5000

# development | production | test
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS. "*" matches one subdomain
# label. Defaults to http://localhost:3000 when unset.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
